---
import Layout from '../layout/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Dashboard - Control de Acceso SENA">
  <Navbar usuario="" cargo="" rol="" activePage="inicio" />
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Barra de búsqueda -->
    <div class="mb-6">
      <div class="relative max-w-2xl">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por cédula o nombre del visitante..."
          class="w-full pl-12 pr-4 py-3 border border-sena-neutral-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent shadow-sm"
        />
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-sena-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Botones de acción rápida -->
    <div class="flex flex-wrap gap-4 mb-8">
      <a href="/registro" class="flex items-center gap-2 px-6 py-3 min-h-[44px] bg-sena-primary text-white rounded-xl hover:bg-sena-primary-dark transition-colors font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
        Nuevo registro
      </a>
      <button id="btn-consultar" class="flex items-center gap-2 px-6 py-3 min-h-[44px] bg-sena-secondary text-white rounded-xl hover:bg-sena-secondary-dark transition-colors font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Consultar
      </button>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Aforo actual -->
      <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-sena-primary">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sena-neutral-500 text-sm">Aforo actual</p>
            <span id="kpi-aforo" class="text-3xl font-bold text-sena-dark overflow-hidden transition-all duration-500 group/span:animate-number">--</span>
          </div>
          <div class="w-12 h-12 bg-sena-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-sena-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Total de Visitantes -->
      <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-sena-accent">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sena-neutral-500 text-sm">Total de Visitantes</p>
            <p id="kpi-visitantes" class="text-3xl font-bold text-sena-dark mt-1">--</p>
          </div>
          <div class="w-12 h-12 bg-sena-accent/10 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-sena-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Total de ingresos semanales -->
      <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-sena-dark">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sena-neutral-500 text-sm">Total de ingresos semanales</p>
            <p id="kpi-ingresos" class="text-3xl font-bold text-sena-dark mt-1">--</p>
          </div>
          <div class="w-12 h-12 bg-sena-dark/10 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-sena-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Salidas pendientes -->
      <div class="bg-white rounded-xl shadow-sm p-6 border-l-4 border-sena-warning">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sena-neutral-500 text-sm">Salidas pendientes</p>
            <p id="kpi-pendientes" class="text-3xl font-bold text-sena-dark mt-1">--</p>
          </div>
          <div class="w-12 h-12 bg-sena-warning/10 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-sena-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Filtros y Gráfico -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <!-- Filtros -->
      <div class="bg-white rounded-xl shadow-sm p-6">
        <h2 class="text-lg font-semibold text-sena-dark mb-4">Filtros de consulta</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-sena-neutral-500 mb-2">Tipo de usuario</label>
            <select id="filter-tipo" class="w-full px-4 py-2 border border-sena-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-sena-primary">
              <option value="">Todos</option>
              <option value="VISITANTE">Visitantes</option>
              <option value="CONTRATISTA">Contratistas</option>
              <option value="INSTRUCTOR">Instructores</option>
              <option value="APRENDIZ">Aprendices</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-sena-neutral-500 mb-2">Fecha de ingreso</label>
            <input type="date" id="filter-fecha-ingreso" aria-label="Fecha de ingreso" class="w-full px-4 py-2 border border-sena-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-sena-primary" />
          </div>
          <div>
            <label class="block text-sm font-medium text-sena-neutral-500 mb-2">Fecha de salida</label>
            <input type="date" id="filter-fecha-salida" aria-label="Fecha de salida" class="w-full px-4 py-2 border border-sena-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-sena-primary" />
          </div>
          <button id="btn-aplicar-filtros" class="w-full px-4 py-2 min-h-[44px] bg-sena-primary text-white rounded-lg hover:bg-sena-primary-dark transition-colors font-medium focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent">
            Aplicar filtros
          </button>
        </div>
      </div>

      <!-- Gráfico de barras -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-semibold text-sena-dark">Ingresos y Salidas</h2>
          <div class="flex items-center gap-4 text-sm">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 bg-sena-primary rounded-full"></div>
              <span class="text-sena-neutral-500">Ingresos</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 bg-sena-neutral-300 rounded-full"></div>
              <span class="text-sena-neutral-500">Salidas</span>
            </div>
          </div>
        </div>
        <div class="h-64">
          <canvas id="stats-chart" aria-label="Gráfico de barras que muestra ingresos y salidas semanales del sistema de control de acceso SENA"></canvas>
        </div>
        <p class="text-sena-neutral-500 text-sm mt-2">El gráfico muestra ingresos (verde) y salidas (gris claro) por semana.</p>
      </div>
    </div>

    <!-- Panel de actividad reciente -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-sena-dark">Últimos ingresos / Salidas</h2>
        <a href="#" class="text-sena-primary hover:text-sena-primary-dark text-sm font-medium focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent">Ver Todos</a>
      </div>
      <div id="recent-activity" class="space-y-4">
        <p class="text-sena-neutral-500 text-center py-4">Cargando actividad...</p>
      </div>
    </div>
  </main>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Check authentication
    const token = localStorage.getItem('token');
    const usuarioStr = localStorage.getItem('usuario');
    const usuario = usuarioStr ? JSON.parse(usuarioStr) : {};

    if (!token || usuario.rol !== 'VIGILANTE') {
      window.location.href = '/';
      return;
    }

  // Initialize chart
  const ctx = document.getElementById('stats-chart') as HTMLCanvasElement;
  if (ctx) {
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: ['01-abr', '02-abr', '03-abr', '04-abr', '05-abr', '06-abr', '07-abr', '08-abr'],
        datasets: [
          {
            label: 'Ingresos',
            data: [110, 120, 100, 130, 108, 125, 95, 115],
            backgroundColor: '#39A900',
            borderRadius: 4,
          },
          {
            label: 'Salidas',
            data: [40, 75, 55, 78, 53, 88, 80, 72],
            backgroundColor: '#DCDCDC',
            borderRadius: 4,
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false,
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            grid: {
              color: '#F6F6F6',
            }
          },
          x: {
            grid: {
              display: false,
            }
          }
        }
      }
    });
  }

  // Load data from API
  async function loadDashboardData() {
    try {
      const headers = { 'Authorization': `Bearer ${token}` };
      
      // Load aforo
      const aforoRes = await fetch('http://localhost:3000/api/reportes/aforo', { headers });
      const aforoData = await aforoRes.json();
      document.getElementById('kpi-aforo').textContent = aforoData.aforo_actual || '0';

      // Load general reports
      const reportesRes = await fetch('http://localhost:3000/api/reportes', { headers });
      const reportesData = await reportesRes.json();
      document.getElementById('kpi-ingresos').textContent = reportesData.total_accesos || '0';
      document.getElementById('kpi-pendientes').textContent = reportesData.sin_salida || '0';

      // Load users for visitor count
      const usuariosRes = await fetch('http://localhost:3000/api/usuarios/listar', { headers });
      const usuariosData = await usuariosRes.json();
      const visitantes = Array.isArray(usuariosData) ? usuariosData.filter((u: any) => u.rol?.nombre === 'VISITANTE').length : 0;
      document.getElementById('kpi-visitantes').textContent = visitantes.toString();

      // Load recent activity
      const accesosRes = await fetch('http://localhost:3000/api/accesos', { headers });
      const accesosData = await accesosRes.json();
      const recentActivity = document.getElementById('recent-activity');
      
      if (Array.isArray(accesosData) && accesosData.length > 0) {
        recentActivity.innerHTML = accesosData.slice(0, 4).map((acceso: any) => {
          const esEntrada = !acceso.hora_salida;
          return `
            <div class="flex items-center justify-between p-4 bg-sena-neutral-100 rounded-xl">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 ${esEntrada ? 'bg-sena-primary' : 'bg-sena-error'} rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    ${esEntrada 
                      ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />'
                      : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />'
                    }
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-sena-dark">${acceso.usuario?.nombre_completo || 'N/A'}</p>
                  <p class="text-sm text-sena-neutral-500">${acceso.usuario?.rol?.nombre || 'N/A'}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-sm font-medium ${esEntrada ? 'text-sena-primary' : 'text-sena-error'}">${esEntrada ? 'ENTRADA' : 'SALIDA'}</p>
                <p class="text-sm text-sena-neutral-500">${esEntrada ? acceso.hora_entrada : acceso.hora_salida}</p>
              </div>
            </div>
          `;
        }).join('');
      } else {
        recentActivity.innerHTML = `
          <div class="skeleton bg-sena-neutral-100/20 rounded-xl p-4 animate-pulse">
            <div class="h-6 w-full rounded-balance mb-2"></div>
            <div class="h-3 w-2/3 rounded-balance mb-1"></div>
            <div class="h-3 w-3/4 rounded-balance"></div>
          </div>
        </p>`;
      }
    } catch (error) {
      console.error('Error loading dashboard data:', error);
    }
  }

  // Search functionality
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const btnConsultar = document.getElementById('btn-consultar');
  
  btnConsultar?.addEventListener('click', () => {
    const doc = searchInput?.value.trim();
    if (doc) {
      window.location.href = `/consulta?doc=${doc}`;
    }
  });

  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      btnConsultar?.click();
    }
  });

  loadDashboardData();
  });
</script>
