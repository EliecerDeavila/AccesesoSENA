---
import Layout from '../layout/Layout.astro';
---

<Layout title="Iniciar Sesión - Control de Acceso SENA">
  <main class="min-h-screen flex bg-gradient-login">
    <!-- Panel Izquierdo (55%) -->
    <div class="hidden lg:flex lg:w-[55%] relative overflow-hidden items-center justify-center p-8">
      <!-- Tarjeta informativa glassmorphism -->
      <div class="relative z-10 bg-white/10 backdrop-blur-md rounded-2xl p-8 max-w-md border border-white/20 shadow-2xl">
        <h2 class="text-white text-3xl font-bold mb-2">Sistema de Control de Acceso</h2>
        <div class="w-full h-px bg-white/30 my-4"></div>
        <p class="text-white/90 text-sm leading-relaxed mb-4">
          Administra el ingreso y salida de manera organizada y en tiempo real.
        </p>
        <p class="text-white font-bold text-lg">SENA - Náutico, Fluvial y Portuario</p>
      </div>
    </div>

    <!-- Panel Derecho (45%) - Formulario -->
    <div class="w-full lg:w-[45%] flex items-center justify-center p-4 bg-white/10 backdrop-blur-md border-l border-white/20">
      <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="flex flex-col items-center mb-8">
          <img src="/image/Logo Blanco.svg" alt="Logo SENA" class="h-20 mb-4" />
          <h1 class="text-white text-2xl font-bold text-center">Iniciar Sesión</h1>
        </div>

        <!-- Formulario -->
        <form id="login-form" class="space-y-6">
          <!-- Campo Usuario -->
          <div>
            <label for="numero_documento" class="block text-white text-sm font-medium mb-2">
              Usuario
            </label>
            <div class="relative">
              <input
                type="text"
                id="numero_documento"
                name="numero_documento"
                placeholder="Ingrese su usuario"
                class="w-full pl-12 pr-4 py-3 bg-black/25 border border-white/30 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-sena-primary-light focus:border-transparent transition-all"
                required
              />
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          </div>

          <!-- Campo Contraseña -->
          <div>
            <label for="password" class="block text-white text-sm font-medium mb-2">
              Contraseña
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Ingrese su contraseña"
                class="w-full pl-12 pr-12 py-3 bg-black/25 border border-white/30 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-sena-primary-light focus:border-transparent transition-all"
                required
              />
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <button type="button" id="toggle-password" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Mensaje de error -->
          <div id="error-message" class="hidden bg-sena-error/20 border border-sena-error text-sena-error px-4 py-3 rounded-lg text-sm"></div>

          <!-- Botón Iniciar -->
          <button
            type="submit"
            id="btn-login"
            class="w-full py-3 bg-gradient-primary border border-white rounded-lg text-white font-semibold text-lg hover:opacity-90 transition-opacity shadow-lg"
          >
            Iniciar
          </button>
        </form>

        <!-- Enlace recuperar contraseña -->
        <div class="mt-6">
          <div class="w-full h-px bg-white/20 mb-4"></div>
          <a href="#" class="text-white/70 text-sm hover:text-white transition-colors block text-center">
            ¿Olvidó su contraseña?
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMessage = document.getElementById('error-message');
  const btnLogin = document.getElementById('btn-login');
  const togglePassword = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  // Toggle password visibility
  togglePassword?.addEventListener('click', () => {
    const type = passwordInput.type === 'password' ? 'text' : 'password';
    passwordInput.type = type;
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const numero_documento = (document.getElementById('numero_documento') as HTMLInputElement).value;
    const password = passwordInput.value;

    // Hide previous error
    errorMessage?.classList.add('hidden');
    
    // Show loading state
    if (btnLogin) {
      btnLogin.textContent = 'Ingresando...';
      (btnLogin as HTMLButtonElement).disabled = true;
    }

    try {
      const response = await fetch('http://localhost:3000/api/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ numero_documento, password }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || 'Error al iniciar sesión');
      }

      // Save token and user data
      localStorage.setItem('token', data.token);
      localStorage.setItem('usuario', JSON.stringify(data.usuario));

      // Redirect based on role
      if (data.usuario.rol === 'ADMINISTRADOR') {
        window.location.href = '/admin';
      } else {
        window.location.href = '/dashboard';
      }
    } catch (error) {
      if (errorMessage) {
        errorMessage.textContent = error instanceof Error ? error.message : 'Error al iniciar sesión';
        errorMessage.classList.remove('hidden');
      }
    } finally {
      if (btnLogin) {
        btnLogin.textContent = 'Iniciar';
        (btnLogin as HTMLButtonElement).disabled = false;
      }
    }
  });
</script>
