---
interface Props {
  usuario: string;
  cargo: string;
  rol: string;
  activePage?: string;
}

const { usuario, cargo, rol, activePage = 'inicio' } = Astro.props;

const menuItems = [
  { name: 'Inicio', href: rol === 'ADMINISTRADOR' ? '/admin' : '/dashboard', id: 'inicio' },
  { name: 'Registros', href: '/registro', id: 'registros' },
];

if (rol === 'ADMINISTRADOR') {
  menuItems.push({ name: 'Reporte', href: '/reportes', id: 'reporte' });
}
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo y nombre -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-sena-primary rounded-full flex items-center justify-center">
          <span class="text-white font-bold text-lg">S</span>
        </div>
        <div>
          <h1 class="text-sena-dark font-bold text-lg leading-tight">Control de Acceso</h1>
          <p class="text-sena-neutral-500 text-xs">Centro Náutico, Fluvial y Portuario</p>
        </div>
      </div>

      <!-- Menú de navegación -->
      <div class="hidden md:flex items-center gap-2">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
              activePage === item.id
                ? 'bg-sena-primary text-white'
                : 'text-sena-dark hover:bg-sena-neutral-100'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Buscador -->
      <div class="hidden lg:flex items-center flex-1 max-w-md mx-8">
        <div class="relative w-full">
          <input
            type="text"
            placeholder="Buscar por cédula"
            class="w-full pl-10 pr-4 py-2 border border-sena-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-sena-primary focus:border-transparent"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-sena-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Perfil y cerrar sesión -->
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-sena-neutral-200 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-sena-neutral-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
            </svg>
          </div>
          <div class="hidden sm:block">
            <p class="text-sm font-medium text-sena-dark">{usuario}</p>
            <p class="text-xs text-sena-neutral-500">{cargo}</p>
          </div>
        </div>
        <button
          id="btn-logout"
          class="flex items-center gap-2 px-3 py-2 text-sena-destructive hover:bg-red-50 rounded-lg transition-colors text-sm font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="hidden sm:inline">Cerrar sesión</span>
        </button>
      </div>

      <!-- Menú móvil -->
      <button id="btn-mobile-menu" class="md:hidden p-2 rounded-lg hover:bg-sena-neutral-100">
        <svg class="w-6 h-6 text-sena-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Menú móvil expandido -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-2">
        {menuItems.map((item) => (
          <a
            href={item.href}
            class={`px-4 py-2 rounded-lg text-sm font-medium ${
              activePage === item.id
                ? 'bg-sena-primary text-white'
                : 'text-sena-dark hover:bg-sena-neutral-100'
            }`}
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const btnMobileMenu = document.getElementById('btn-mobile-menu');
  const mobileMenu = document.getElementById('mobile-menu');
  const btnLogout = document.getElementById('btn-logout');

  btnMobileMenu?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  btnLogout?.addEventListener('click', () => {
    localStorage.removeItem('token');
    localStorage.removeItem('usuario');
    window.location.href = '/';
  });
</script>
