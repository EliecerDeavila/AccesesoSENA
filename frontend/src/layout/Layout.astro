---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  showFooter?: boolean;
}

const {
  title,
  description,
  image = '/public/image/Imagen-fondo.jpg',
  showFooter = true,
} = Astro.props;
---

<html lang="es">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="flex-1">
      <slot />
    </div>
    {showFooter && <Footer />}
  </body>
</html>